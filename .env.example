# FreeField environment configuration
# Copy to .env.local for local dev. NEVER commit .env.local.
#
# Per plan v3 §6.6: each company deploying FreeField provisions their own
# Firebase project. The build reads these vars at Vite build time. Deploy
# guide: docs/deploy/README.md.

# --- Firebase client config (public, baked into the bundle) ---
# Get these from Firebase Console → Project settings → General → Your apps.
# All values are safe to ship in client code (Firebase Auth/Firestore security
# rules enforce server-side access control regardless of these values).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Tenant isolation (P0.3) ---
# REQUIRED. The Firebase project ID this build was CONFIGURED for. Compared
# at app boot against the runtime Firebase app's project ID — mismatch throws
# TenantMismatchError and refuses to start. This is the BYO-deployment safety
# net: prevents a contractor from accidentally connecting to the wrong
# company's Firebase project by running the wrong .env.
#
# Convention: set this to the same value as VITE_FIREBASE_PROJECT_ID. The
# separate variable exists so a build can be verified against the manifest
# even if VITE_FIREBASE_PROJECT_ID is missing or wrong.

VITE_EXPECTED_FIREBASE_PROJECT_ID=

# --- Optional: Functions region (Phase 1) ---
# Default: us-central1. Set if your Firebase project is in a different region.
# VITE_FIREBASE_FUNCTIONS_REGION=

# --- Demo mode (plan v4.1, thesis demo) ---
# VITE_FF_DEMO_AUTH=true boots the app with ZERO Firebase backend: no
# sign-in wall. An anonymous visitor is a "viewer" (read-only Documents /
# Models / Linkview); a one-click "View as: Viewer | Admin" switch at the
# bottom of the left rail unlocks Settings / Users / authoring. The role
# persists in localStorage['ff-demo-role']. The real email-link auth path
# is untouched when this is false/unset.
# VITE_FF_DEMO_AUTH=false

# --- Optional: Custom email provider (Phase 1, production only) ---
# Phase 0 spike uses Firebase default email templates (ugly + spam-prone).
# Production should use Resend or SendGrid. NOT used at build time — set
# as a Firebase Functions runtime secret instead (firebase functions:secrets:set).
# RESEND_API_KEY=
# EMAIL_FROM="FreeField <noreply@your-domain.com>"