rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Cloud Storage holds (a) task media: task photos and the
    // location-snapshot thumbnail, written by the task outbox
    // (packages/ff-tasks/src/repository.ts `photoPath`,
    // packages/ff-tasks/src/photos.ts `locationThumbPath`), and (b) since
    // Phase 1d the synced model/plan blobs: projects/{pid}/{ifc,frag,pdf}/
    // {versionId}.{ext} (docs/SPEC-PHASE-1.md §4). Devices download `.frag`
    // and PDF; the `.ifc` upload is optional.
    //
    // Everything else is denied (wave 63: there used to be an open
    // `allow read, write: if true` catch-all here, and it was deployed).
    // The emulator uses these same rules; no local feature needs open access.

    // Phase 1b (docs/SPEC-PHASE-1.md §3): authorize by the Firestore member
    // doc, not by token claims. Revocation is immediate and a user may
    // belong to many projects. (Storage rules read Firestore through
    // `firestore.get` / `firestore.exists`.)
    function memberPath(pid) {
      return /databases/(default)/documents/projects/$(pid)/members/$(request.auth.uid);
    }
    function isMember(pid) {
      return request.auth != null
        && firestore.exists(memberPath(pid))
        && firestore.get(memberPath(pid)).data.status == 'active';
    }
    function isAdmin(pid) {
      return isMember(pid)
        && firestore.get(memberPath(pid)).data.role == 'admin';
    }

    // ── Task photos + location thumb (task-39 D3, Day-3) ─────────
    // Path shapes:
    //   projects/{pid}/tasks/{taskId}/{sha256prefix}-{index}.{jpg|png|webp}
    //   projects/{pid}/tasks/{taskId}/location-thumb.jpg
    // Members read and upload; objects are immutable (no overwrite, so
    // a sha-named photo can't be swapped after the task doc references
    // it); deletes are admin-only (the v1 UI never deletes photos).
    match /projects/{pid}/tasks/{taskId}/{photoId} {
      allow read: if isMember(pid);
      allow create: if isMember(pid)
        // Overwrites can be evaluated as `create` (seen on the emulator), so
        // immutability is pinned here too: only a brand-new object passes.
        && resource == null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update: if false;
      allow delete: if isAdmin(pid);
    }

    // ── Synced blobs (Phase 1d, SPEC-PHASE-1 §4/§8) ──────────────
    // Path shapes (named by the version doc id; helpers in
    // packages/ff-firestore/src/storage/paths.ts):
    //   projects/{pid}/pdf/{versionId}.pdf    <= 200 MB, application/pdf
    //   projects/{pid}/frag/{versionId}.frag  <= 500 MB, application/octet-stream
    //   projects/{pid}/ifc/{versionId}.ifc    <= 1 GB,   application/octet-stream
    // Members read; admins create. Objects are immutable: no update, and
    // `resource == null` pins create to brand-new objects (overwrites can be
    // evaluated as `create`). Client DELETE is denied for everyone (a
    // delete + re-create would be an overwrite under a recorded sha256);
    // the 30-day tombstone GC deletes with the Admin SDK (Phase 1e).
    match /projects/{pid}/pdf/{file} {
      allow read: if isMember(pid);
      allow create: if isAdmin(pid)
        && resource == null
        && file.matches('[A-Za-z0-9_-]+[.]pdf')
        && request.resource.size <= 200 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update, delete: if false;
    }
    match /projects/{pid}/frag/{file} {
      allow read: if isMember(pid);
      allow create: if isAdmin(pid)
        && resource == null
        && file.matches('[A-Za-z0-9_-]+[.]frag')
        && request.resource.size <= 500 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
      allow update, delete: if false;
    }
    match /projects/{pid}/ifc/{file} {
      allow read: if isMember(pid);
      allow create: if isAdmin(pid)
        && resource == null
        && file.matches('[A-Za-z0-9_-]+[.]ifc')
        && request.resource.size <= 1024 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
      allow update, delete: if false;
    }

    // Default deny. Rules are allow-only, so this is the same as having no
    // match at all; it is spelled out so nobody re-adds an open catch-all.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
