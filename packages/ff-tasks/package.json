    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "dexie": "^4.0.10",
    "firebase": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "dexie": "^4.0.10",
    "eslint": "^8.57.1",
    "firebase": "^11.0.0",
    "typescript": "5.6.3",
    "vitest": "^2.1.5",
    "xmllint-wasm": "^5.3.0"
  }
