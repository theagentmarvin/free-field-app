{
  "name": "@ff/tasks",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Headless task data plane: state machine, outbox engine, drafts, cloud-first repository merge. No UI, no viewer imports.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
