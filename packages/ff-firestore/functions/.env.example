# Cloud Functions params. Copy to `.env.<your-firebase-project-id>` (git-ignored).
# Comma-separated emails allowed to bootstrap the first admin of a fresh project.
BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# Origin of YOUR deployed web app (no trailing slash), e.g. https://field.acme.com
# Used for the sign-in email link that invitations / first-admin bootstrap send,
# and as an allowlist: a continueUrl on any other origin is rejected. If unset it
# falls back to http://localhost:5173, which is only right for local development.
APP_ORIGIN=https://<your-domain>
# Optional: BOOTSTRAP_SECRET is NOT set here; create it with
#   firebase functions:secrets:set BOOTSTRAP_SECRET
