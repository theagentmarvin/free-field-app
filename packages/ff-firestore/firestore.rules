rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // FreeField two-role security matrix (plan v4 §2, amendment v4.1)
    //
    // Phase 1b (docs/SPEC-PHASE-1.md §3): membership is decided by the
    // member doc /projects/{pid}/members/{uid} (status 'active'), NOT by
    // token claims. A user may belong to many projects, and removing or
    // demoting a member takes effect on their very next request (no token
    // refresh). The only remaining claim read is the roster-profile rule
    // below (isProfileReadable), dropped in Phase 1e.
    //
    //   admin  → write (create/update/delete) the project content collections
    //             (projects, and the synced content collections of Phase 1c: buildings,
    //             ifcFiles, ifcVersions, storeys, extractedStoreys, pdfFiles,
    //             pdfVersions, calibrations, folders, folderAssignments,
    //             viewpoints; hard delete denied, tombstone via update). Membership, invitation and
    //             audit-log mutations are functions-only (see below) — an
    //             admin's client write surface does NOT cover them.
    //   member → read-only consumption; no writes anywhere, except plan
    //             markups (planMarkups: members author their own, see below).
    //
    // Membership mutation, invitation create/revoke, redemption and bootstrap
    // all run inside Cloud Functions (admin SDK) — never client-side — so the
    // client rules deny those paths entirely (`write: if false`).
    // ─────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(pid) {
      return /databases/$(database)/documents/projects/$(pid)/members/$(request.auth.uid);
    }

    // True when the caller has an ACTIVE member doc in `pid`.
    // (get/exists on the same path are billed once per evaluation.)
    function isMember(pid) {
      return isSignedIn()
        && exists(memberDoc(pid))
        && get(memberDoc(pid)).data.status == 'active';
    }

    // True when the caller is an active admin of `pid` (implies isMember).
    function isAdmin(pid) {
      return isMember(pid)
        && get(memberDoc(pid)).data.role == 'admin';
    }

    // ── Task state-machine legality (task-module plan §3) ────────
    // Keep textually in sync with the client map in
    // packages/ff-tasks/src/status.ts — one table, two consumers.
    // `from == to` covers comment/edit/assign-without-move and is
    // only legal for the four open states: 65 (approved) and 80
    // (discontinued) are terminal — they accept NO further writes,
    // so no self-transition pair is listed for them and a comment
    // on a closed task needs a followup (40→60) first, exactly §3.
    // 30 is enum-only parity with Commercial Viewer's Rejected —
    // unreachable in v1 (reject lands back in 20, rework loop),
    // hence no pair touches it.
    function legalTaskTransition(from, to) {
      return (from == to && (from == 10 || from == 20 || from == 40 || from == 60))
        || (from == 10 && to == 20)                       // assign
        || (from == 20 && to == 40)                       // complete
        || (from == 40 && (to == 20 || to == 60 || to == 65 || to == 80)) // reject / followup / approve / discontinue
        || (from == 60 && (to == 40 || to == 80))         // complete / discontinue
        || ((from == 10 || from == 20) && to == 80);      // discontinue (open ends too)
    }

    // ── /users/{uid}: profile mirrored from Firebase Auth ──
    // Read: your OWN profile, or the profile of someone on the roster of
    // the project you are currently working in (the members table and the
    // task assignee picker join roster uids to profile emails/names).
    // Profiles of users outside your project are not readable (wave 63).
    // A user may write only their OWN profile (this is the doc that
    // triggers onCreateUser).
    //
    // Phase 1b: rules cannot enumerate the caller's projects, so "the
    // project you are working in" is still the `currentProject` claim
    // (kept in step with the selection by the setActiveProject callable).
    // The claim only NAMES the project; the caller must still be an ACTIVE
    // member of it, so a removed member loses profile reads immediately.
    // Phase 1e replaces this by denormalizing name/email onto the member doc.
    function isProfileReadable(userId) {
      return isSignedIn()
        && (request.auth.uid == userId
          || (request.auth.token.currentProject != null
            && isMember(request.auth.token.currentProject.id)
            && exists(/databases/$(database)/documents/projects/$(request.auth.token.currentProject.id)/members/$(userId))));
    }

    // Field allowlist for profile docs. Mirrors UserSchema
    // (packages/ff-firestore/src/schema/user.ts); FinishSignInPage writes
    // { uid, email, createdAt } with merge. `request.resource.data` is the
    // whole resulting doc (merge included), so hasOnly bounds the stored doc.
    function hasOnlyProfileKeys() {
      return request.resource.data.keys().hasOnly(
        ['uid', 'email', 'displayName', 'createdAt', 'lastSignInAt']);
    }

    match /users/{userId} {
      // Profile mirrored from Firebase Auth. Email-of-record is pinned to the
      // verified token identity (P0-1): a client can never write a different
      // email than the one bound to their own auth record. Update self-heals
      // (NEW-5): any update must carry the caller's OWN verified email, so a
      // stale profile converges after a legitimate email change while forged
      // emails stay impossible. delete is denied so the onCreateUser trigger
      // cannot be re-armed by deleting + recreating the profile doc (P1-3).
      //
      // v4 profile-update shape: there is no `displayName`-only update. A
      // `displayName` (or any other field) update must include the current
      // token email in the SAME write — else the projected doc still carries
      // the stale email and the write is denied. This is the only supported
      // profile-update shape in v4 (see FinishSignInPage, which always writes
      // `{ uid, email, ... }` with the token email).
      allow read: if isProfileReadable(userId);
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && hasOnlyProfileKeys()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.auth.token.email_verified == true;
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && hasOnlyProfileKeys()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.auth.token.email_verified == true;
      allow delete: if false;
    }

    // ── Project surface ──────────────────────────────────────────
    match /projects/{pid} {
      // read = member; write = admin.
      allow read: if isMember(pid);
      allow write: if isAdmin(pid);

      // ── Synced content collections (Phase 1c, SPEC-PHASE-1 §4/§8) ──
      // One match per Dexie table, flat under the project. Read = any
      // active member (tombstones included, so offline peers learn about
      // deletes). Write = admin only, and every write must:
      //   - carry EXACTLY the zod schema's keys (packages/ff-firestore/
      //     src/schema/{building,folder,sync}.ts): hasOnly + hasAll;
      //   - stamp updatedAt == request.time (serverTimestamp()),
      //     updatedBy == the caller, schema == 1;
      //   - set deletedAt to null (live) or request.time (tombstone);
      //   - carry `id` == the doc id (and projectId == pid where present).
      // Deletes are TOMBSTONES via update. Hard delete is denied for
      // everyone (members never write; admins neither): a hard delete is
      // invisible to a peer that was offline, so it would resurrect the row
      // from that peer's cache. The 30-day tombstone GC (Phase 1e) runs with
      // the Admin SDK, which bypasses rules.
      // Version docs are append-only: identity, blob location and checksum
      // are immutable once set; only isLatest, the tombstone, and (ifcVersions)
      // filling in a still-null blob reference may change.
      function syncKeys() {
        return ['updatedAt', 'updatedBy', 'deletedAt', 'schema'];
      }
      function hasExactly(keys) {
        return request.resource.data.keys().hasOnly(keys)
          && request.resource.data.keys().hasAll(keys);
      }
      function syncStamp(docId) {
        let d = request.resource.data;
        return d.updatedAt == request.time
          && d.updatedBy == request.auth.uid
          && d.schema == 1
          && (d.deletedAt == null || d.deletedAt == request.time)
          && d.id == docId;
      }
      function keepsFields(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields) == false;
      }
      // Immutable-once-set blob reference (null -> value is allowed once).
      function blobFieldKept(field) {
        return resource.data[field] == null
          || request.resource.data[field] == resource.data[field];
      }
      function blobGroupConsistent(a, b, c, d) {
        let r = request.resource.data;
        return (r[a] == null) == (r[b] == null)
          && (r[a] == null) == (r[c] == null)
          && (r[a] == null) == (r[d] == null);
      }

      match /buildings/{docId} {
        function keys() {
          return ['id', 'projectId', 'name', 'metadata', 'createdAt'].concat(syncKeys());
        }
        function valid() {
          let d = request.resource.data;
          return hasExactly(keys()) && syncStamp(docId)
            && d.projectId == pid
            && d.name is string && d.name.size() > 0 && d.name.size() <= 200
            && d.metadata is map && d.createdAt is number;
        }
        allow read: if isMember(pid);
        allow create: if isAdmin(pid) && valid() && request.resource.data.deletedAt == null;
        allow update: if isAdmin(pid) && valid()
          && keepsFields(['id', 'projectId', 'createdAt']);
        allow delete: if false;
      }

      match /ifcFiles/{docId} {
        function keys() {
          return ['id', 'buildingId', 'name', 'currentVersionId', 'createdAt'].concat(syncKeys());
        }
        function valid() {
          let d = request.resource.data;
          return hasExactly(keys()) && syncStamp(docId)
            && d.buildingId is string && d.buildingId.size() > 0
            && d.name is string && d.name.size() > 0
            && d.currentVersionId is string && d.createdAt is number;
        }
        allow read: if isMember(pid);
        allow create: if isAdmin(pid) && valid() && request.resource.data.deletedAt == null;
        allow update: if isAdmin(pid) && valid()
          && keepsFields(['id', 'buildingId', 'name', 'createdAt']);
        allow delete: if false;
      }

      match /ifcVersions/{docId} {
        function keys() {
          return ['id', 'ifcFileId', 'versionNumber', 'ifcFileSize', 'contentHash',
            'fragBlobKey', 'storeyCount', 'createdAt', 'isLatest',
            'storagePath', 'sha256', 'sizeBytes', 'contentType',
            'fragStoragePath', 'fragSha256', 'fragSizeBytes'].concat(syncKeys());
        }
        function ifcPath() {
          return 'projects/' + pid + '/ifc/' + docId + '.ifc';
        }
        function fragPath() {
          return 'projects/' + pid + '/frag/' + docId + '.frag';
        }
        function valid() {
          let d = request.resource.data;
          return hasExactly(keys()) && syncStamp(docId)
            && d.ifcFileId is string && d.ifcFileId.size() > 0
            && d.versionNumber is int && d.versionNumber > 0
            && d.ifcFileSize is number && d.contentHash is string
            && d.fragBlobKey is string && d.storeyCount is number
            && d.createdAt is number && d.isLatest is bool
            // IFC blob reference: all four fields null together, or all set.
            && blobGroupConsistent('storagePath', 'sha256', 'sizeBytes', 'contentType')
            && (d.storagePath == null
              || (d.storagePath == ifcPath()
                && d.sha256 is string && d.sha256.matches('[0-9a-f]{64}')
                && d.sizeBytes is int && d.sizeBytes >= 0 && d.sizeBytes <= 1073741824
                && d.contentType == 'application/octet-stream'))
            // .frag reference: path + sha256 + size, all null together, or all set.
            && (d.fragStoragePath == null) == (d.fragSha256 == null)
            && (d.fragStoragePath == null) == (d.fragSizeBytes == null)
            && (d.fragStoragePath == null
              || (d.fragStoragePath == fragPath()
                && d.fragSha256 is string && d.fragSha256.matches('[0-9a-f]{64}')
                && d.fragSizeBytes is int && d.fragSizeBytes >= 0
                && d.fragSizeBytes <= 524288000));
        }
        allow read: if isMember(pid);
        allow create: if isAdmin(pid) && valid() && request.resource.data.deletedAt == null;
        allow update: if isAdmin(pid) && valid()
          && keepsFields(['id', 'ifcFileId', 'versionNumber', 'ifcFileSize',
            'contentHash', 'fragBlobKey', 'createdAt'])
          && blobFieldKept('storagePath') && blobFieldKept('sha256')
          && blobFieldKept('sizeBytes') && blobFieldKept('contentType')
          && blobFieldKept('fragStoragePath') && blobFieldKept('fragSha256')
          && blobFieldKept('fragSizeBytes');
        allow delete: if false;
      }

      match /storeys/{docId} {
        function keys() {
          return ['id', 'buildingId', 'ifcVersionId', 'sourceIfcFileId', 'name',
            'elevation', 'expressId', 'height', 'containedElementIds'].concat(syncKeys());
        }
        function valid() {
          let d = request.resource.data;
          return hasExactly(keys()) && syncStamp(docId)
            && d.buildingId is string && d.buildingId.size() > 0
            && d.ifcVersionId is string && d.ifcVersionId.size() > 0
            && d.sourceIfcFileId is string && d.sourceIfcFileId.size() > 0
            && d.name is string && d.elevation is number && d.expressId is int
            && (d.height == null || d.height is number)
            && d.containedElementIds is list && d.containedElementIds.size() <= 100000;
        }
        allow read: if isMember(pid);
        allow create: if isAdmin(pid) && valid() && request.resource.data.deletedAt == null;
        allow update: if isAdmin(pid) && valid()
          && keepsFields(['id', 'buildingId', 'ifcVersionId', 'sourceIfcFileId']);
        allow delete: if false;
      }

      match /extractedStoreys/{docId} {
        function keys() {
          return ['id', 'buildingId', 'storeyId'].concat(syncKeys());
        }
        function valid() {
          let d = request.resource.data;
          return hasExactly(keys()) && syncStamp(docId)
            && d.buildingId is string && d.buildingId.size() > 0
            && d.storeyId is string && d.storeyId.size() > 0;
        }
        allow read: if isMember(pid);
        allow create: if isAdmin(pid) && valid() && request.resource.data.deletedAt == null;
        allow update: if isAdmin(pid) && valid()
          && keepsFields(['id', 'buildingId', 'storeyId']);
        allow delete: if false;
      }

      match /pdfFiles/{docId} {
        function keys() {
          return ['id', 'buildingId', 'name', 'createdAt'].concat(syncKeys());
        }
        function valid() {
          let d = request.resource.data;
          return hasExactly(keys()) && syncStamp(docId)
            && d.buildingId is string && d.buildingId.size() > 0
            && d.name is string && d.name.size() > 0 && d.createdAt is number;
        }
        allow read: if isMember(pid);
        allow create: if isAdmin(pid) && valid() && request.resource.data.deletedAt == null;
        allow update: if isAdmin(pid) && valid()
          && keepsFields(['id', 'buildingId', 'name', 'createdAt']);
        allow delete: if false;
      }

      match /pdfVersions/{docId} {
        function keys() {
          return ['id', 'pdfFileId', 'versionNumber', 'name', 'size', 'contentHash',
            'pageCount', 'width', 'height', 'storedAt', 'blobKey', 'isLatest',
            'storagePath', 'sha256', 'sizeBytes', 'contentType'].concat(syncKeys());
        }
        function valid() {
          let d = request.resource.data;
          return hasExactly(keys()) && syncStamp(docId)
            && d.pdfFileId is string && d.pdfFileId.size() > 0
            && d.versionNumber is int && d.versionNumber > 0
            && d.name is string && d.size is number && d.contentHash is string
            && d.pageCount is int && d.pageCount > 0
            && d.width is number && d.height is number && d.storedAt is number
            && d.blobKey is string && d.isLatest is bool
            && d.storagePath == 'projects/' + pid + '/pdf/' + docId + '.pdf'
            && d.sha256 is string && d.sha256.matches('[0-9a-f]{64}')
            && d.sizeBytes is int && d.sizeBytes >= 0 && d.sizeBytes <= 209715200
            && d.contentType == 'application/pdf';
        }
        allow read: if isMember(pid);
        allow create: if isAdmin(pid) && valid() && request.resource.data.deletedAt == null;
        // Append-only: only isLatest and the tombstone move.
        allow update: if isAdmin(pid) && valid()
          && keepsFields(['id', 'pdfFileId', 'versionNumber', 'name', 'size',
            'contentHash', 'pageCount', 'width', 'height', 'storedAt', 'blobKey',
            'storagePath', 'sha256', 'sizeBytes', 'contentType']);
        allow delete: if false;
      }

      // Deterministic doc id: `{pdfFileId}__{encodeURIComponent(storeyName)}`
      // (calibrationDocId in @ff/firestore), so two devices calibrating the
      // same pair converge on one doc.
      match /calibrations/{docId} {
        function keys() {
          return ['id', 'projectId', 'pdfFileId', 'storeyName', 'pointPairs',
            'transformParams', 'confidence', 'createdAt'].concat(syncKeys());
        }
        function valid() {
          let d = request.resource.data;
          return hasExactly(keys()) && syncStamp(docId)
            && d.projectId == pid
            && d.pdfFileId is string && d.pdfFileId.matches('[A-Za-z0-9_-]+')
            && d.storeyName is string && d.storeyName.size() > 0
            && docId.matches(d.pdfFileId + '__.+')
            && d.pointPairs is list && d.pointPairs.size() == 2
            && d.transformParams is map
            && d.transformParams.keys().hasOnly(['scale', 'rotation', 'translateX', 'translateZ'])
            && d.transformParams.keys().hasAll(['scale', 'rotation', 'translateX', 'translateZ'])
            && d.confidence is number && d.createdAt is number;
        }
        allow read: if isMember(pid);
        allow create: if isAdmin(pid) && valid() && request.resource.data.deletedAt == null;
        allow update: if isAdmin(pid) && valid()
          && keepsFields(['id', 'projectId', 'pdfFileId', 'storeyName', 'createdAt']);
        allow delete: if false;
      }

      match /folders/{docId} {
        function keys() {
          return ['id', 'projectId', 'parentId', 'name', 'color', 'createdAt'].concat(syncKeys());
        }
        function valid() {
          let d = request.resource.data;
          return hasExactly(keys()) && syncStamp(docId)
            && d.projectId == pid
            && (d.parentId == null || (d.parentId is string && d.parentId != docId))
            && d.name is string && d.name.size() > 0 && d.name.size() <= 200
            && d.color is string && d.createdAt is number;
        }
        allow read: if isMember(pid);
        allow create: if isAdmin(pid) && valid() && request.resource.data.deletedAt == null;
        allow update: if isAdmin(pid) && valid()
          && keepsFields(['id', 'projectId', 'createdAt']);
        allow delete: if false;
      }

      // Doc id == pdfFileId (one folder per PDF).
      match /folderAssignments/{docId} {
        function keys() {
          return ['id', 'pdfFileId', 'folderId', 'createdAt'].concat(syncKeys());
        }
        function valid() {
          let d = request.resource.data;
          return hasExactly(keys()) && syncStamp(docId)
            && d.pdfFileId == docId
            && d.folderId is string && d.folderId.size() > 0
            && d.createdAt is number;
        }
        allow read: if isMember(pid);
        allow create: if isAdmin(pid) && valid() && request.resource.data.deletedAt == null;
        allow update: if isAdmin(pid) && valid()
          && keepsFields(['id', 'pdfFileId', 'createdAt']);
        allow delete: if false;
      }

      // Shared per project (SPEC-PHASE-1 Q4). `blob` is the JSON snapshot.
      match /viewpoints/{docId} {
        function keys() {
          return ['id', 'projectId', 'name', 'createdAt', 'blob'].concat(syncKeys());
        }
        function valid() {
          let d = request.resource.data;
          return hasExactly(keys()) && syncStamp(docId)
            && d.projectId == pid
            && d.name is string && d.name.size() > 0 && d.name.size() <= 200
            && d.createdAt is number
            && d.blob is string && d.blob.size() <= 256000;
        }
        allow read: if isMember(pid);
        allow create: if isAdmin(pid) && valid() && request.resource.data.deletedAt == null;
        allow update: if isAdmin(pid) && valid()
          && keepsFields(['id', 'projectId', 'createdAt']);
        allow delete: if false;
      }

      // Plan markups: vector drawings on one page of a plan version. Unlike
      // the collections above, any active MEMBER authors them: create needs
      // createdBy == the caller; update / tombstone needs the author or an
      // admin. Identity, plan reference and authorship are immutable.
      // `shape` is the JSON-encoded PlanMarkupShape (<= 100 KB).
      match /planMarkups/{docId} {
        function keys() {
          return ['id', 'projectId', 'pdfFileId', 'pdfVersionId', 'page', 'kind',
            'color', 'strokeWidth', 'shape', 'bbox', 'taskId', 'createdBy', 'createdAt']
            .concat(syncKeys());
        }
        function valid() {
          let d = request.resource.data;
          return hasExactly(keys()) && syncStamp(docId)
            && d.projectId == pid
            && d.pdfFileId is string && d.pdfFileId.size() > 0
            && d.pdfVersionId is string && d.pdfVersionId.size() > 0
            && d.page is int && d.page > 0
            && d.kind in ['pen', 'highlight', 'arrow', 'rect', 'ellipse', 'cloud', 'text']
            && d.color is string && d.color.matches('^#[0-9a-fA-F]{6}$')
            && d.strokeWidth is number && d.strokeWidth > 0 && d.strokeWidth <= 0.1
            && d.shape is string && d.shape.size() >= 2 && d.shape.size() <= 100000
            && d.bbox is list && d.bbox.size() == 4
            && (d.taskId == null || (d.taskId is string && d.taskId.size() > 0))
            && d.createdBy is string && d.createdBy.size() > 0
            && d.createdAt is number;
        }
        allow read: if isMember(pid);
        allow create: if isMember(pid) && valid()
          && request.resource.data.deletedAt == null
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(pid) && valid()
          && keepsFields(['id', 'projectId', 'pdfFileId', 'pdfVersionId', 'page', 'createdBy', 'createdAt'])
          && (resource.data.createdBy == request.auth.uid || isAdmin(pid));
        allow delete: if false;
      }

      // Members: read = any project member (roster); write = functions-only.
      // Roster reads are the assignment surface: member docs carry
      // name/email/role, which is exactly what a project roster may expose
      // to its own members — the assignee picker needs the full active
      // roster, not just the caller's own doc. isMember(pid) bounds every
      // read to the project (and already covers admins, since isAdmin implies
      // isMember), so non-members still see nothing.
      // Client-side member writes are the delta-review's residual lockout
      // vector: a just-demoted admin's ID token keeps its claim for ≤1 h, so
      // direct client writes would bypass the transactional last-admin guard.
      // All membership mutations happen in Cloud Functions via the Admin SDK
      // (setMemberRole, removeMember, redeemInvitation, bootstrap) — they
      // bypass rules, so the client surface is closed entirely.
      match /members/{uid} {
        allow read: if isMember(pid);
        allow write: if false;
      }

      // Invitations: admin-only client READ; client WRITES are functions-only.
      // Every invitation write already flows through the `inviteMember` callable
      // (and `removeMember` revocation) via the Admin SDK — no client code
      // writes invitation docs — so the client write surface is closed entirely
      // (NEW-R3-1). A removed admin's residual ≤1h ID token therefore cannot
      // mint a self-serving invitation client-side. Redemption also runs in
      // `redeemInvitation` with the admin SDK (read stays admin for the UI).
      match /invitations/{iid} {
        allow read: if isAdmin(pid);
        allow write: if false;
      }

      // Audit log: append-only via Cloud Function; admin read only.
      match /auditLog/{entryId} {
        allow read: if isAdmin(pid);
        allow write: if false;
      }

      // ── Tasks — DELIBERATE MATRIX AMENDMENT (task-39 D7) ───────
      // The v4 matrix says: members write NOTHING anywhere (plan v4
      // §2). Tasks are the first exception by design — issue/observation
      // tracking is a whole-crew activity, and the Android data plane
      // depends on member-authored writes. Everything else about the
      // matrix is unchanged: membership, invitations and auditLog stay
      // functions-only. Legality here mirrors §3 of the task-module
      // plan; num/createdBy*/createdAt are immutable; every update
      // must bump entryCount by exactly one (the matching append-only
      // entry rides the same transaction); there is no client delete
      // — discontinue is the soft-close verb.
      // Shape validation (wave 63). Field lists mirror TaskSchema /
      // TaskEntrySchema (packages/ff-firestore/src/schema/task*.ts) and what
      // packages/ff-tasks/src/repository.ts actually writes:
      //   create = ONE transaction: counter set {next}, task set (full DTO,
      //            entryCount 1), entry set (the 'create' entry).
      //   update = ONE transaction: entry set + task update with
      //            entryCount increment(1).
      // Coupling: a task create must bump the counter to exactly its `num`
      // in the same write (getAfter); an entry create must ride a task write
      // in the same transaction that bumps entryCount by one and matches the
      // entry's statusFrom/statusTo (get/getAfter). A task update cannot
      // name its entry (the doc doesn't carry the clientGuid), so that
      // direction is enforced only by the +1 entryCount rule.
      function taskPath(pid, taskId) {
        return /databases/$(database)/documents/projects/$(pid)/tasks/$(taskId);
      }
      function counterPath(pid) {
        return /databases/$(database)/documents/projects/$(pid)/taskCounters/tasks;
      }
      function hasOnlyTaskKeys() {
        return request.resource.data.keys().hasOnly([
          'id', 'num', 'title', 'description', 'type', 'status',
          'createdBy', 'createdByUid', 'createdAt', 'updatedBy', 'updatedAt',
          'assigneeUid', 'assigneeName', 'deadline', 'buildingId',
          'location', 'photos', 'lastAction', 'entryCount',
          // Additive, optional fields (absent reads as the default):
          // priority / checklist / watchers (w69) and sheetRefs (sheets
          // attached from the project, by reference only).
          'priority', 'checklist', 'watchers', 'sheetRefs']);
      }
      // Cheap shape checks for the additive fields. Rules cannot iterate
      // lists; element shapes are validated client-side (taskFields.ts).
      function validTaskExtras() {
        let d = request.resource.data;
        return (!('priority' in d) || d.priority in ['low', 'normal', 'high', 'critical'])
          && (!('checklist' in d) || (d.checklist is list && d.checklist.size() <= 50))
          && (!('watchers' in d) || (d.watchers is list && d.watchers.size() <= 100))
          && (!('sheetRefs' in d) || (d.sheetRefs is list && d.sheetRefs.size() <= 20));
      }
      // w72: location.pdf may carry an OPTIONAL pdfVersionId (the plan
      // revision the pin was placed on). Absent stays valid (pre-w72
      // pins); when present it must be a non-empty string. All other
      // location shapes are unchanged (not shape-checked here).
      function validTaskLocation() {
        let loc = request.resource.data.location;
        return loc == null
          || !(loc is map)
          || !('pdf' in loc)
          || loc.pdf == null
          || !(loc.pdf is map)
          || !('pdfVersionId' in loc.pdf)
          || (loc.pdf.pdfVersionId is string && loc.pdf.pdfVersionId.size() > 0);
      }
      // The counter must go from num-1 (or absent, for num == 1) to num
      // in this same write — so two tasks can never share a number and a
      // task can't claim a number nobody allocated.
      function counterBumpedTo(pid, num) {
        return getAfter(counterPath(pid)).data.next == num
          && (exists(counterPath(pid))
            ? get(counterPath(pid)).data.next == num - 1
            : num == 1);
      }

      match /tasks/{taskId} {
        allow read: if isMember(pid);
        allow create: if isMember(pid)
          && hasOnlyTaskKeys()
          && validTaskLocation()
          && validTaskExtras()
          && request.resource.data.id == taskId
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.num is int
          && request.resource.data.num > 0
          // The 'create' entry is written in the same transaction, so a
          // fresh task already counts one entry.
          && request.resource.data.entryCount == 1
          && request.resource.data.lastAction == 'create'
          && (request.resource.data.status == 10 || request.resource.data.status == 20)
          && counterBumpedTo(pid, request.resource.data.num);
        allow update: if isMember(pid)
          && hasOnlyTaskKeys()
          && validTaskLocation()
          && validTaskExtras()
          && request.resource.data.id == resource.data.id
          && request.resource.data.num == resource.data.num
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.entryCount == resource.data.entryCount + 1
          && legalTaskTransition(resource.data.status, request.resource.data.status);
        allow delete: if false;

        match /entries/{entryId} {
          allow read: if isMember(pid);
          // Append-only audit trail: docId IS the clientGuid
          // (outbox idempotency key), author is the caller, and the entry
          // must ride the task write of the same transaction.
          allow create: if isMember(pid)
            && request.resource.data.keys().hasOnly([
              'id', 'action', 'text', 'by', 'byUid', 'at',
              'statusFrom', 'statusTo', 'photos', 'clientGuid'])
            && entryId == request.resource.data.clientGuid
            && request.resource.data.id == entryId
            && request.resource.data.byUid == request.auth.uid
            && entryMatchesTaskWrite(pid, taskId);
          allow update, delete: if false;
        }
      }

      // Entry ↔ task coupling. Create entry: the task is new in this write,
      // starts at entryCount 1 and its status is the entry's statusTo.
      // Any other entry: the task existed, its entryCount goes up by exactly
      // one in this write, and the entry records the real status edge.
      function entryMatchesTaskWrite(pid, taskId) {
        let after = getAfter(taskPath(pid, taskId)).data;
        return request.resource.data.statusTo == after.status
          && (request.resource.data.action == 'create'
            ? (!exists(taskPath(pid, taskId))
              && request.resource.data.statusFrom == null
              && after.entryCount == 1)
            : (exists(taskPath(pid, taskId))
              && request.resource.data.statusFrom == get(taskPath(pid, taskId)).data.status
              && after.entryCount == get(taskPath(pid, taskId)).data.entryCount + 1));
      }

      // Per-project display-number generator. First task creates
      // {next: 1}; every later allocation increments by exactly one
      // inside the same transaction that writes the task doc.
      match /taskCounters/{counterId} {
        allow read: if isMember(pid);
        allow create: if isMember(pid)
          && counterId == 'tasks'
          && request.resource.data.keys().hasOnly(['next'])
          && request.resource.data.next is int
          && request.resource.data.next == 1;
        allow update: if isMember(pid)
          && request.resource.data.keys().hasOnly(['next'])
          && request.resource.data.next == resource.data.next + 1;
        allow delete: if false;
      }
    }

    // ── Membership discovery (Phase 1b, SPEC-PHASE-1 §2.1) ───────
    // The client finds ALL its projects with
    //   collectionGroup('members').where('uid','==',me).where('status','==','active')
    // This rule allows exactly that: a member doc is readable by the user
    // it names (resource.data.uid). Docs without a `uid` field (pre-backfill)
    // are never matched. Writes stay functions-only (the per-project match
    // above); rules OR together, so project members still read their roster.
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ── Bootstrap meta: Cloud Function (admin SDK) only ──────────
    match /meta/{doc} {
      allow read, write: if false;
    }
  }
}