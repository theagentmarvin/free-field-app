{
  "name": "@ff/sync",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Headless Phase 1c/1d sync engine: Dexie <-> Firestore/Storage adapters, down-sync listeners, generalized outbox drain, blob upload/download. No React, no DOM; Firestore, Storage and blob storage are injected. Shared by the web app and the mobile app.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./firebase": "./src/firebase.ts"
  },
  "scripts": {
    "test": "vitest run --no-file-parallelism --exclude \"__tests__/emulator/**\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test:emulator": "node ../ff-firestore/node_modules/firebase-tools/lib/bin/firebase.js emulators:exec --config ../../firebase.sync-emulator.json --only firestore,storage --project demo-freefield \"vitest run --no-file-parallelism __tests__/emulator\""
  },
  "dependencies": {
    "@ff/data": "workspace:*",
    "@ff/firestore": "workspace:*",
    "@ff/tasks": "workspace:*",
    "@ff/types": "workspace:*",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "dexie": "^4.0.10",
    "firebase": "^11.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.0.0",
    "dexie": "^4.0.10",
    "fake-indexeddb": "^6.0.0",
    "firebase": "^11.0.0",
    "typescript": "5.6.3",
    "vitest": "^2.1.5"
  }
}
