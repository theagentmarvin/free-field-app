{
  "name": "@ff/data",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Shared data core for FreeField: the Dexie database (single app-wide instance), table accessors, calibration math, and the IFC/PDF pipeline hooks. Framework-agnostic core (@ff/data) + React hooks subpath (@ff/data/hooks). Consumes @ff/types for record shapes.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./db/*": "./src/db/*.ts",
    "./calibration/*": "./src/calibration/*.ts"
  },
  "scripts": {
    "test": "vitest run --no-file-parallelism --passWithNoTests",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:drift": "node ../../apps/settings/scripts/toe-drift-check.js src",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@ff/types": "workspace:*",
    "@thatopen/fragments": "3.6.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "web-ifc": "^0.0.77"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "typescript": "5.6.3",
    "vitest": "^2.1.5"
  }
}
