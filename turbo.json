{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "VITE_*",
        "SENTRY_*"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint:drift": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [],
      "outputs": []
    },
    "test:emulator": {
      "cache": false,
      "dependsOn": []
    }
  }
}
