{
  "name": "free-field-monorepo",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "FreeField monorepo — pnpm workspaces + Turborepo. apps/* for modules, packages/* for shared foundation.",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev --parallel",
    "lint:drift": "turbo run lint:drift",
    "typecheck": "turbo run typecheck",
    "test:emulator": "turbo run test:emulator --concurrency=1",
    "build:selfhost": "pnpm build && node scripts/prune-demo-assets.mjs"
  },
  "devDependencies": {
    "firebase-admin": "^14.2.0",
    "turbo": "2.9.18",
    "typescript": "5.6.3"
  },
  "packageManager": "pnpm@10.30.1"
}
