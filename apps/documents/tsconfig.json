{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      // The Documents module depends on shared data plumbing that
      // lives in @free-field/settings (Dexie schema, useBuildingTabs,
      // createProject, etc.). The aliases below resolve those imports
      // to apps/settings/src/... so a single Vite build (in
      // apps/settings) can bundle both modules with one Dexie
      // instance and one origin → same IndexedDB → same DB.
      //
      // The dependency direction is one-way: settings → documents for
      // the runtime entry (DocumentsApp), and documents → settings
      // for shared data plumbing + the DocFileRecord etc. types.
      // Vite + esbuild handle the graph fine because the data hooks
      // and types live in their own subtrees (settings/src/hooks,
      // settings/src/core) and don't import from documents.
      "@ff/auth": ["../../packages/ff-auth/src"],
      "@ff/viewer-tools/pdf-measure": ["../../packages/ff-viewer-tools/src/pdfMeasure/index.ts"],
      "@free-field/models": ["../models/src"],
      "@ff/viewer-react": ["../../packages/ff-viewer-react/src"],
      "@ff/viewer": ["../../packages/ff-viewer/src"],
      "@ff/types": ["../../packages/ff-types/src"]
    },
    "types": ["vitest/globals", "node", "vite/client"]
  },
  "include": ["src", "__tests__"]
}
