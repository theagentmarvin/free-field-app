{
  "name": "@free-field/linkview",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "FreeField — Linkview module: side-by-side PDF + IFC viewer for calibrated (pdf, storey) pairs. Lists only PDFs that have a calibration to a floor plan in the active building, plus the building's extracted (model) floor plans. Hosted by @free-field/settings (single Vite origin, same Dexie DB).",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run --no-file-parallelism --passWithNoTests",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ff/auth": "workspace:*",
    "@ff/types": "workspace:*",
    "@ff/data": "workspace:*",
    "@ff/tasks-react": "workspace:*",
    "@ff/viewer": "workspace:*",
    "@ff/viewer-react": "workspace:*",
    "@ff/viewer-tools": "workspace:*",
    "dexie-react-hooks": "^1.1.7",
    "iconoir-react": "^7.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
