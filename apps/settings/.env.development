# Local development defaults: `pnpm --filter settings dev` starts the
# app in DEMO MODE — no Firebase project, no sign-in; data stays in the
# browser. Load public/samples/sample.ifc from Settings to get started.
#
# To develop against your own Firebase project instead, create
# apps/settings/.env.local (git-ignored) with your VITE_FIREBASE_* values
# and VITE_FF_DEMO_AUTH=false — .env.local overrides this file.
# Production builds ignore this file (they read .env.production).
VITE_FF_DEMO_AUTH=true
