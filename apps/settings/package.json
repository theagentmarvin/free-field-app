{
  "name": "@free-field/settings",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Free Field \u2014 Settings module: PDF + IFC combined viewer for BIM (Phase 1: IFC flow + level extraction)",
  "scripts": {
    "dev": "npm run setup && node scripts/dev-server.mjs",
    "build": "npm run setup && tsc -b && vite build",
    "test": "vitest run --no-file-parallelism",
    "lint": "eslint . --ext .ts,.tsx",
    "preview": "vite preview",
    "setup": "node scripts/setup-wasm.mjs && node scripts/setup-pdfjs-assets.mjs",
    "postinstall": "node scripts/setup-wasm.mjs || true",
    "lint:drift": "node scripts/toe-drift-check.js src"
  },
  "dependencies": {
    "@ff/auth": "workspace:*",
    "@ff/data": "workspace:*",
    "@ff/firestore": "workspace:*",
    "@ff/tasks-react": "workspace:*",
    "@ff/telemetry": "workspace:*",
    "@ff/tooling": "workspace:*",
    "@ff/types": "workspace:*",
    "@ff/viewer": "workspace:*",
    "@ff/viewer-react": "workspace:*",
    "@ff/viewer-tools": "workspace:*",
    "@free-field/documents": "workspace:*",
    "@free-field/linkview": "workspace:*",
    "@free-field/models": "workspace:*",
    "@free-field/users": "workspace:*",
    "@thatopen/components": "^3.6.0",
    "@thatopen/fragments": "3.6.0",
    "camera-controls": "^3.1.2",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "firebase": "^11.0.0",
    "iconoir-react": "^7.11.1",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "three": "^0.182.0",
    "web-ifc": "^0.0.77",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^11.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.182.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.22.4",
    "typescript": "5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
