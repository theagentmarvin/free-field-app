# Production build (Firebase Hosting). Copy to apps/settings/.env.production (git-ignored)
# and fill in the values from Firebase Console -> Project settings -> Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<your-project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<your-project-id>
VITE_FIREBASE_STORAGE_BUCKET=<your-project-id>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_EXPECTED_FIREBASE_PROJECT_ID=<your-project-id>
VITE_FIREBASE_USE_EMULATOR=false
# Demo auth must be off for a real deployment.
VITE_FF_DEMO_AUTH=false
# Optional: region of your deployed Cloud Functions (default us-central1).
# VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# Server-side params (APP_ORIGIN, BOOTSTRAP_ADMIN_EMAILS) are NOT read by the
# web build. They live in packages/ff-firestore/functions/.env.<project-id>;
# see packages/ff-firestore/functions/.env.example and docs/deploy/self-hosting.md.
